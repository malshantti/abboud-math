[{"id":"u1","t":"Unit 1 — All about me (كلّ شيء عنّي)","les":[{"id":"e1l","t":"Language — His / Her — He's / She's","q":[["Manar is a girl. ___ name is Manar.",["Her","His","He"],0,6]]}]},{"id":"u2","t":"Unit 2 — He's a doctor (إنّه طبيب)","les":[{"id":"e2l","t":"Language — What's his/her job? He's/She's a …","q":[["What's his job? He's a ___ . (يعالج الأسنان)",["dentist","farmer","driver"],0,12],["He drives a bus. He's a ___ .",["driver","nurse","teacher"],0,12],["She works in a school. She's a ___ .",["teacher","farmer","doctor"],0,12],["Who's he? He's my ___ . (والد أبي)",["grandfather","aunt","sister"],0,12],["He grows olives. He's a ___ .",["farmer","police officer","dentist"],0,12]]}]},{"id":"u3","t":"Unit 3 — At the market (في السوق)","les":[{"id":"e3l","t":"Language — I'd like … please. / I don't like …","q":[["What is it?",["bananas","grapes","figs"],0,18],["What is it?",["carrots","onions","potatoes"],0,18],["What is it?",["tomatoes","apples","oranges"],0,18],["I'd like figs, please. — ___",["Here you are.","I'm fine.","My name's Ali."],0,18],["That's 10 ___ .",["dinars","apples","teachers"],0,18],["What is it?",["grapes","melon","bananas"],0,18]]}]},{"id":"u4","t":"Unit 4 — At the zoo (في حديقة الحيوان)","les":[{"id":"e4l","t":"Language — It's … / It has …","q":[["It has no legs. It's a ___ .",["snake","monkey","tiger"],0,24],["It's big and grey. It's an ___ .",["elephant","fox","snake"],0,24],["It has a long neck. It's a ___ .",["giraffe","fox","monkey"],0,24],["What is it?",["monkey","tiger","giraffe"],0,24],["What is it?",["fox","elephant","snake"],0,24],["The tiger is ___ and black.",["orange","grey","blue"],0,24]]}]},{"id":"u6","t":"Unit 6 — I don't feel well (لا أشعر أنّي بخير)","les":[{"id":"e6l","t":"Language — What's the matter? My … hurts.","q":[["My teeth hurt. — Go to the ___ .",["dentist","farmer","zoo"],0,36],["What's the matter?",["My head hurts.","I'm 9.","It's sunny."],0,36],["one tooth, two ___",["teeth","tooths","foots"],0,36],["one foot, two ___",["feet","foots","teeth"],0,36],["I feel tired. — Go to ___ .",["bed","school","the market"],0,36],["Take this ___ .",["medicine","banana","car"],0,36],["معدة = ?",["stomach","back","head"],0,36]]}]},{"id":"u7","t":"Unit 7 — My day (يومي)","les":[{"id":"e7l","t":"Language — What do you do in the …? / When do you …?","q":[["I go to ___ at night.",["bed","school","the market"],0,42],["أكتب الواجب = ?",["I do homework.","I watch cartoons.","I get up."],0,42],["What do you do in the afternoon?",["I play computer games.","My head hurts.","It's cold."],0,42],["in the ___ (المساء)",["evening","morning","night"],0,42],["I ___ cartoons.",["watch","go","get"],0,42],["I go to school in the ___ .",["morning","night","evening"],0,42]]}]},{"id":"u8","t":"Unit 8 — It's sunny (الجوّ مشمس)","les":[{"id":"e8l","t":"Language — What's the weather? It's … / at the …","q":[["What's the weather?",["cloudy","sunny","windy"],0,48],["Where are they?",["at the beach","at the zoo","at school"],0,48],["ماطر = ?",["rainy","windy","cold"],0,48],["It's hot. Let's go to the ___ .",["swimming pool","doctor","bed"],0,48]]}]}]