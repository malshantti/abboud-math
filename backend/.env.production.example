APP_NAME="بستان التعلّم"
APP_ENV=production
# Generate once: php artisan key:generate  (or paste base64:... from a secure generator)
APP_KEY=
APP_DEBUG=false
APP_URL=https://bustankids.com/admin-api
STUDENT_SITE_URL=https://bustankids.com
# Leave empty: the package ships admin/, assets/ and catalog.js inside bustankids-app/frontend
ADMIN_FRONTEND_PATH=

APP_LOCALE=ar
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# cPanel > MySQL Databases: names are prefixed with the account, e.g. huztimedia_bustan
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=huztimedia_bustan
DB_USERNAME=huztimedia_bustan
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

SESSION_DRIVER=database
SESSION_COOKIE=bustan_admin_session
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/admin-api
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
# Password-reset email. cPanel > Email Accounts: create e.g. no-reply@bustankids.com, then:
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=mail.bustankids.com
MAIL_PORT=465
MAIL_USERNAME=no-reply@bustankids.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@bustankids.com
MAIL_FROM_NAME="بستان التعلّم"
DISPLAY_TIMEZONE=Asia/Hebron

# One-time setup without SSH only (32+ random chars). DELETE the value after setup.
SETUP_TOKEN=
SETUP_ADMIN_EMAIL=mohammedalshantti2000@gmail.com
SETUP_ADMIN_NAME="Mohammed Alshantti"
